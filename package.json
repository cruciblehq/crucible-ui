{
    "name": "@cruciblehq/ui",
    "version": "0.0.0",
    "description": "React reconciler for the Crucible ecosystem.",
    "private": false,
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "LICENSE",
        "CHANGELOG.md",
        "package.json",
        "dist"
    ],
    "scripts": {
        "build": "tsc",
        "watch": "tsc --watch",
        "clean": "rm -rf dist tsconfig.tsbuildinfo",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix"
    },
    "dependencies": {
        "react-reconciler": "^0.33.0"
    },
    "devDependencies": {
        "@types/react": "^19.2.2",
        "@types/react-reconciler": "^0.28.0",
        "typescript": "^5.9.3",
        "@typescript-eslint/eslint-plugin": "^8.46.2",
        "@typescript-eslint/parser": "^8.46.2",
        "eslint": "^9.38.0"
    },
    "keywords": [
        "crucible",
        "crucible-ui",
        "ui",
        "component",
        "declarative",
        "widget",
        "react",
        "reconciler"
    ],
    "author": "Crucible Inc.",
    "license": "UNLICENSED",
    "homepage": "https://github.com/cruciblehq/crucible-ui",
    "repository": {
        "type": "git",
        "url": "https://github.com/cruciblehq/crucible-ui",
        "directory": "packages/crucible-ui"
    },
    "bugs": {
        "url": "https://github.com/cruciblehq/crucible-ui/issues"
    },
    "publishConfig": {
        "access": "public"
    }
}